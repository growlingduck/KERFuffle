{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KERFuffle",
  "version": "0.2.0",
  "identifier": "com.kerfuffle.app",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KERFuffle",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "KERFuffle",
    "copyright": "© 2026 KERFuffle",
    "category": "Productivity",
    "shortDescription": "Cabinet cut lists for the shop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "kerfjob"
        ],
        "name": "KERFuffle.Job",
        "description": "KERFuffle job",
        "role": "Editor",
        "mimeType": "application/vnd.kerfuffle.job+json"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "customLanguageFiles": {
          "English": "windows/English.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QTM3MzQxMTM0MjA5RTQKUldUa0NVSVRRWE9qaG8rWmNNRWF2TUpJUVB6OUwvT2VzZEZadE9PRFMrOFNPUEprVGdUM3k2djkK",
      "endpoints": [
        "https://github.com/growlingduck/KERFuffle/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
